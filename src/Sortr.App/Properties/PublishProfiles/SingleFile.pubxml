<?xml version="1.0" encoding="utf-8"?>
<!--
  Self-contained single Sortr.exe that runs on any 64-bit Windows 10/11 PC without .NET installed.
  Usage (from the repo root): dotnet publish src/Sortr.App -p:PublishProfile=SingleFile
  Output: publish/Sortr.exe
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Fold WPF's native DLLs into the exe (extracted to a temp folder on first launch). -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <!-- No separate .pdb next to the exe. -->
    <DebugType>embedded</DebugType>
    <!-- Don't copy Sortr.Core.pdb either. -->
    <AllowedReferenceRelatedFileExtensions>.none</AllowedReferenceRelatedFileExtensions>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\publish\</PublishDir>
  </PropertyGroup>
</Project>
