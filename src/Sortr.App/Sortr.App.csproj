<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Sortr.Core\Sortr.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>Sortr</AssemblyName>
    <RootNamespace>Sortr.App</RootNamespace>
    <Product>Sortr</Product>
    <!-- Release builds override this from the git tag (see .github/workflows/release.yml). -->
    <Version>1.0.0</Version>
    <AssemblyTitle>Sortr</AssemblyTitle>
    <Description>Moves files into the right folders by reading their names.</Description>
    <ApplicationIcon>Assets\Sortr.ico</ApplicationIcon>
    <!-- ThemeMode (Fluent theme / system dark mode) is flagged experimental. -->
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets\Sortr.ico" />
  </ItemGroup>

</Project>
