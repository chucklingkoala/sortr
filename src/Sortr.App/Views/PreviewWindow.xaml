<Window x:Class="Sortr.App.Views.PreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Preview" Icon="pack://application:,,,/Sortr;component/Assets/Sortr.ico"
        Width="760" Height="600" MinWidth="360" MinHeight="300"
        ShowInTaskbar="False" ShowActivated="False"
        WindowStartupLocation="CenterOwner"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="FontFamily" Value="{StaticResource IconFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Width" Value="40" />
            <Setter Property="Padding" Value="0,6" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header: name, facts, open button -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock x:Name="FileNameText" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="InfoText" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
            <Button x:Name="OpenButton" Grid.Column="1" Content="Open" Click="OpenButton_Click"
                    Margin="12,0,0,0" MinWidth="80" VerticalAlignment="Center"
                    ToolTip="Open the file in its default app" />
        </Grid>

        <!-- Content -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="0" ClipToBounds="True">
            <Grid>
                <Image x:Name="ImageView" Stretch="Uniform" StretchDirection="DownOnly" Margin="8"
                       RenderOptions.BitmapScalingMode="HighQuality" Visibility="Collapsed" />

                <MediaElement x:Name="MediaView" LoadedBehavior="Manual" UnloadedBehavior="Close"
                              Stretch="Uniform" Visibility="Collapsed"
                              MediaOpened="MediaView_MediaOpened" MediaEnded="MediaView_MediaEnded"
                              MediaFailed="MediaView_MediaFailed" />

                <TextBlock x:Name="AudioGlyph" Text="&#xE8D6;" FontFamily="{StaticResource IconFont}" FontSize="72"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />

                <TextBox x:Name="TextView" IsReadOnly="True" IsReadOnlyCaretVisible="True"
                         FontFamily="Cascadia Mono, Consolas, Courier New" FontSize="13"
                         TextWrapping="NoWrap" AcceptsReturn="True" AcceptsTab="True"
                         HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                         BorderThickness="0" Background="Transparent" Padding="10,8"
                         Visibility="Collapsed" />

                <TextBlock x:Name="MessageText" TextWrapping="Wrap" TextAlignment="Center" Margin="24"
                           HorizontalAlignment="Center" VerticalAlignment="Bottom"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" Visibility="Collapsed" />
            </Grid>
        </Border>

        <!-- Footer: media controls, or a note about the content -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid x:Name="MediaControls" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button x:Name="PlayPauseButton" Style="{StaticResource IconButton}" Content="&#xE768;"
                        Click="PlayPauseButton_Click" ToolTip="Play" />
                <Slider x:Name="PositionSlider" Grid.Column="1" Margin="12,0" VerticalAlignment="Center"
                        Minimum="0" Maximum="1" IsMoveToPointEnabled="True"
                        ValueChanged="PositionSlider_ValueChanged" />
                <TextBlock x:Name="TimeText" Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0"
                           FontFamily="Cascadia Mono, Consolas" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                <Button x:Name="MuteButton" Grid.Column="3" Style="{StaticResource IconButton}" Content="&#xE767;"
                        Click="MuteButton_Click" ToolTip="Mute" />
            </Grid>
            <TextBlock x:Name="FooterText" Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       TextTrimming="CharacterEllipsis" Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>
